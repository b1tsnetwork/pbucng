# Zusätzlicher Sprach-Server (Profil „voice“) – kopieren nach deploy/communication/ucng-voice.env
# Alle Optionen mit Erklärung: UCNG deploy/voice/.env.example und docs/voice-deployment.md

# Derselbe Wert wie VOICE_AGENT_TOKEN in ucng.env (Pflicht)
AGENT_TOKEN=
# Adresse, unter der Browser diesen Sprach-Server erreichen (eigene Subdomain mit TLS)
PUBLIC_URL=wss://voice1.firma.local
# Chat-Server im Docker-Netz
CHAT_URL=http://ucng:8080
