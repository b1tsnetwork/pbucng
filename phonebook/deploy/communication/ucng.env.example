# UCNG im Phonebook-Betrieb – kopieren nach deploy/communication/ucng.env
# Das Sicherheitsprofil (MODE, LOCK_*, TRUST_PROXY, PUBLIC_URL) steht fest in compose.communication.yml.

# Superadmin für /admin (Notfallzugang; ab PH-02 Anmeldung über das Telefonbuch)
ADMIN_PASSWORD=

# AGPL: Adresse des Quellcodes dieser (geänderten) Fassung – Pflicht, wenn Personen sie über das Netz nutzen (ADR-016)
SOURCE_URL=

TZ=Europe/Berlin
STORAGE=files
DB_DSN=
BACKUP_KEEP=7

# Vertrauenswürdige Proxys (Docker-Netz ist privat und damit Standard)
TRUSTED_PROXIES=

# Sprachkanäle
VOICE=1
VOICE_BUILTIN=1
VOICE_MAX_PARTICIPANTS=200
VOICE_MAX_MBIT=50
VOICE_MAX_PER_IP=40
# Nur mit Profil „voice“: Schlüssel für zusätzliche Sprach-Server
VOICE_AGENT_TOKEN=

# Spracherkennung: erst ab PH-09 und nach organisatorischer Klärung (ADR-011)
STT_URL=
