# Beispiel: Caddy als HTTPS-Gateway (Subdomain-Betrieb, ADR-004). Caddy reicht WebSocket und
# SSE ohne Puffer selbst richtig weiter. Danach prüfen mit „telefonbuch commcheck“.
# (Vorlage; automatisiert getestet wurde die Routing-Logik mit tools/devgateway.)

telefonbuch.firma.local {
	tls /etc/ssl/firma/telefonbuch.crt /etc/ssl/firma/telefonbuch.key
	@internal path /api/internal/*
	respond @internal 404   # Server-zu-Server der Kommunikation nur intern (PH-02)
	reverse_proxy 127.0.0.1:8080
}

kommunikation.firma.local {
	tls /etc/ssl/firma/kommunikation.crt /etc/ssl/firma/kommunikation.key
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8095 {
		flush_interval -1
	}
}
