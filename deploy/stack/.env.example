# Telefonbuch + Kommunikation – Stack-Einstellungen (nach .env kopieren)
# Geheimnisse gehören NICHT hierher, sondern nach secrets/ (sh secrets/create.sh).

# Dienste-Gruppen: communication = Kommunikation (UCNG), backup = tägliche Datenbank-Sicherung,
# stt = Spracherkennung (erst nach Freigabe, ADR-011). Ohne communication: Telefonbuch allein.
COMPOSE_PROFILES=communication,backup

# ---------------------------------------------------------------- Versionen (fest eintragen)
TB_VERSION=1.0.0-rc.1
# Stand der Kommunikation mit MODE=phonebook (Branch phonebook-integration, siehe RELEASE-NOTES)
UCNG_VERSION=
MYSQL_VERSION=8.4
CADDY_VERSION=2.10
# eigene Registry statt ghcr.io (optional)
#TB_IMAGE=registry.firma.local/telefonbuch
#UCNG_IMAGE=registry.firma.local/ucng

# ---------------------------------------------------------------- Adressen
TB_DOMAIN=telefonbuch.firma.local
COMM_DOMAIN=kommunikation.firma.local
TZ=Europe/Berlin

# ---------------------------------------------------------------- TLS am Gateway
# files = eigene Zertifikate in gateway/certs, internal = Caddy-CA (Test), acme = öffentlich
TLS_MODE=files
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# internes Docker-Netz zwischen Gateway und Diensten (Proxy-Vertrauen); nur ändern bei Überschneidung
EDGE_SUBNET=172.30.10.0/24
GATEWAY_IP=172.30.10.2
EDGE_IP_RANGE=172.30.10.128/25

# ---------------------------------------------------------------- Kommunikation
# false = Telefonbuch ohne Kommunikation (dann auch „communication“ aus COMPOSE_PROFILES nehmen)
COMMUNICATION_ENABLED=true
UCNG_PHONEBOOK_REVALIDATE=5m
UCNG_PHONEBOOK_GRACE=15m
UCNG_PHONEBOOK_LIFECYCLE=6h
UCNG_PHONEBOOK_RETENTION_DAYS=90
UCNG_BACKUP_KEEP=14
# 0 = nur abgesetzte Sprach-Server (voice-node/), 1 = auch der eingebaute
UCNG_VOICE_BUILTIN=1
# Spracherkennung: erst nach Freigabe (ADR-011), dann z. B. http://stt:8000/v1/audio/transcriptions
UCNG_STT_URL=
UCNG_STT_MODEL=Systran/faster-whisper-small
UCNG_STT_LANGUAGE=de
UCNG_TRANSCRIPT_KEEP_DAYS=14
STT_IMAGE_TAG=latest-cpu

# ---------------------------------------------------------------- Datenbank-Sicherung (Profil backup)
DB_BACKUP_DIR=./backup/dumps
DB_BACKUP_KEEP_DAYS=14
DB_BACKUP_TIME=02:30
