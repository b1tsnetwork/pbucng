# Abgesetzter Sprach-Server – nach .env kopieren und ausfüllen
UCNG_VERSION=
# Name, unter dem der Server im Admin-Bereich erscheint (je Server eindeutig)
AGENT_ID=voice1
# eigene Adresse dieses Servers und Adresse der Kommunikation (Haupt-Server)
VOICE_DOMAIN=voice1.firma.local
COMM_DOMAIN=kommunikation.firma.local
TZ=Europe/Berlin
# files = certs/voice.crt + voice.key (Firmen-CA), internal = Caddy-CA (nur Test), acme = öffentlich
TLS_MODE=files
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
CADDY_VERSION=2.10
# leer = Sprache, Bildschirm und Kameras · media = nur ausgelagerte Bildschirme und Kameras
ROLE=
MAX_PARTICIPANTS=200
MAX_MBIT=50
MAX_PER_IP=40
EDGE_SUBNET=172.31.10.0/24
GATEWAY_IP=172.31.10.2
EDGE_IP_RANGE=172.31.10.128/25
# Spracherkennung auf diesem Server: erst nach Freigabe (ADR-011)
STT_URL=
